# Local development only. Set an actual seeded CRM sandbox, never a production account.
CRM_URL=http://localhost:4200
SANDBOX_CONFIRMED=false
BEACON_ORIGINS=http://localhost:8010,http://localhost:8011,http://127.0.0.1:8010,http://127.0.0.1:8011
# Optional local OpenAI-compatible Kokoro service; leave blank for browser voice.
TTS_URL=
TTS_PROVIDER=browser
# Optional keyless online test voice: TTS_PROVIDER=edge. Sends assistant narration to Microsoft.
TTS_VOICE=af_heart
# true (default): the demo browser is hidden and appears only inside the website popup.
# false: also show it as a separate Chrome window (debugging only).
HEADLESS=true
# --- Start-up secrets: fill these once and ./start.ps1 stops asking. Local test machine only; never commit .env. ---
# If a value contains # $ or spaces, wrap it in single quotes.
# Local models only; no hosted provider fallback.
PLANNER_PROVIDER=local
# Test CRM account for the hidden demo browser. Or leave blank and run ./login.ps1 once.
BEACON_LOGIN_USER=
BEACON_LOGIN_PASSWORD=
# Local operator development ONLY, with explicit permission to share real device location with CRM.
LOCAL_DEVICE_LOCATION=false

# Shared local Qwen3 runtime: current trained adapter for conversation and qualification.
LOCAL_MODEL_URL='http://127.0.0.1:8014'
LOCAL_CHAT_MODEL='beacon-qwen3-17k'
QUAL_SLM_URL='http://127.0.0.1:8014/v1'
QUAL_SLM_MODEL='beacon-qwen3-17k'
QUAL_SLM_FORMAT='facts'
QUAL_SLM_TIMEOUT='180'
DOCS_ANSWER=extractive

# Same shared model and adapter as qualification. Base setup: python slm/setup_planner.py.
PLANNER_BACKEND='llamacpp'
PLANNER_MODEL_URL='http://127.0.0.1:8014'
PLANNER_MODEL='beacon-qwen3-17k'
# Optional PostgreSQL; blank uses SQLite for one local demonstration.
BEACON_DATABASE_URL=
